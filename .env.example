# Keep .env local and out of source control. This remains a Sandbox/local prototype.
APP_BASE_URL=http://127.0.0.1:8000
LAPENG_DB=lapeng.sqlite3
LAPENG_DEMO_DATA=1
# Currently reserved; session tokens use cryptographic random values stored hashed.
APP_SECRET=replace-with-long-random-secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Groq uses the OpenAI-compatible endpoint. Verify your available models in Groq console.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Optional local-only moderator account(s) by the database USER ID, not email.
# To select the right ID, sign in and inspect the "id" in GET /api/me.
# Do not grant privileges based on unverified email addresses.
APP_MODERATOR_USER_IDS=
# Important: selected Sandbox currencies only. No live payouts, automated FX or ZAR checkout.

# Optional road travel times (Google Maps Routes API, requires billing and quota restrictions)
GOOGLE_ROUTES_API_KEY=
# Optional appointment reminders (requires explicit user opt-in and scheduled worker)
LAPENG_SMTP_HOST=
LAPENG_SMTP_PORT=587
LAPENG_SMTP_FROM=
LAPENG_SMTP_USER=
LAPENG_SMTP_PASSWORD=

# Optional PayPal Sandbox webhook signature verification (configure a webhook in developer dashboard)
PAYPAL_WEBHOOK_ID=
# Platform operator IDs are configured through APP_MODERATOR_USER_IDS above.
